# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server only. Never put this key in browser code, screenshots or logs.
SUPABASE_SERVICE_ROLE_KEY=

APP_ENV=development
# Production: HTTPS origin only, e.g. https://food.example.edu
PUBLIC_BASE_URL=
# Production requires a shared Redis service. Local development can use memory://.
RATELIMIT_STORAGE_URI=memory://
# Leave blank locally to store sessions in instance/sessions.
# Production can reuse a Redis RATELIMIT_STORAGE_URI, or use a separate Redis DB.
SESSION_REDIS_URL=
# Set only to the number of trusted reverse proxies in front of this app.
TRUSTED_PROXY_COUNT=0
SESSION_LIFETIME_SECONDS=28800
# Customer cart/history lasts 35 days; staff sign-in keeps the separate 8-hour limit.
CUSTOMER_SESSION_LIFETIME_SECONDS=3024000
PORT=5001

# Docker Compose optional HTTPS proxy: set a public hostname (no scheme/path).
PUBLIC_DOMAIN=

# Optional: configure all three and run the push worker to enable background alerts.
# Generate local keys: python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.edu
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
